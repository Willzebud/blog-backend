# Copier ce fichier en .env puis remplacer les valeurs fictives.

# URI de connexion MongoDB (obligatoire)
DATABASE_URL=mongodb://localhost:27017/blog

# Secret de signature des access tokens JWT (obligatoire)
# Utiliser une longue chaîne aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-secret

# Variables facultatives :
# PORT=3000            port HTTP (3000 par défaut)
# NODE_ENV=production  ajoute l'attribut Secure au cookie de refresh token
